{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bcv",
  "main": "./index.js",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "catalogo-db",
      "database_id": "da0637af-2641-466b-9b33-856682857bd6"
    }
  ],
  "triggers": {
    "crons": ["0 12 * * *"]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": false
    }
  },
  // ...
}